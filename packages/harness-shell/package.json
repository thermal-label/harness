{
  "name": "@thermal-label/harness-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Vue shell + DriverAdapter abstraction for the thermal-label harness apps. Workspace-internal — never published. Each per-driver app (apps/harness-<driver>/) is a thin wrapper that supplies a DriverAdapter and calls createHarness; the sections, state, status polling, submit-flow, and chrome live here. Ships .vue and .ts source; consuming Vite app handles compilation.",
  "type": "module",
  "license": "MIT",
  "author": "Mannes Brak",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles": "./src/styles/global.css"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@mbtech-nl/bitmap": "^1.3.0",
    "@thermal-label/contracts": "^0.6.0",
    "@thermal-label/harness-components": "workspace:*",
    "@thermal-label/harness-core": "workspace:*",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@mbtech-nl/bitmap": "^1.3.0",
    "@mbtech-nl/eslint-config": "^1.1.0",
    "@mbtech-nl/tsconfig": "^1.1.0",
    "@thermal-label/contracts": "^0.6.0",
    "@thermal-label/harness-components": "workspace:*",
    "@thermal-label/harness-core": "workspace:*",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^15.0.0",
    "typescript": "~5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
